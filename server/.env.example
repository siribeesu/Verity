# Select one provider: anthropic, openai, gemini, or grok.
PROVIDER=anthropic

# Set the API key for the selected provider. Leave the other keys blank.
ANTHROPIC_API_KEY=replace_with_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional model overrides. Defaults are shown.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

GROK_API_KEY=
GROK_MODEL=grok-3

# Local server settings
PORT=3001
NODE_ENV=development
