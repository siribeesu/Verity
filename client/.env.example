# Public OIDC client settings; these are not secrets.
VITE_OIDC_AUTHORITY=https://identity.example.com
VITE_OIDC_CLIENT_ID=your_registered_client_id
VITE_OIDC_RESOURCE=https://api.example.com
VITE_OIDC_SCOPE=openid profile email api.read
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173